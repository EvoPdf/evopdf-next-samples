@model EvoPdf_Next_AspNetDemo.Models.PDF_Creator.Create_PDF_Documents_ViewModel
@{
    ViewBag.Title = "Create PDF Documents with Text and Images";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    TreeView_ToggleNode("demoTreeView_HTML_To_PDF_Converter");
    TreeView_ToggleNode("demoTreeView_PDF_Creator");
    TreeView_SelectNode("demoTreeView_Create_PDF_Documents");
</script>

<form asp-action="CreatePdf" asp-controller="Create_PDF_Documents" method="post">
    <table style="width: 100%; height: 100%">
        <tbody>
            <tr>
                <td style="border: solid 1px Black; padding-top: 10px; padding-left: 10px; padding-right: 10px; padding-bottom: 0px">
                    <table style="width: 100%; height: 100%">
                        <tbody>
                            <tr>
                                <td style="font-size: 16px; font-weight: bold; height: 20px; padding-bottom: 15px; padding-top: 5px">
                                    Create PDF Documents with Text and Images
                                </td>
                            </tr>
                            <tr>
                                <td style="width: 100%;">

                                    <table style="width: 535px; height: 967px">
                                        <tbody>
                                            <tr>
                                                <td style="vertical-align: top">
                                                    <table>
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    Use this demo to create PDF documents programmatically by adding text and images.
                                                                    The generated PDF demonstrates standard PDF fonts and Unicode TrueType fonts, PNG and JPEG images with custom dimensions,
                                                                    multi-page text continuation with per-page borders, mixed page orientations and right-to-left content.<br /> <br />
                                                                    You can enhance the generated PDF by adding security features such as encryption, permissions or a digital signature,
                                                                    as well as custom headers and footers or other visual elements like stamps and shapes.
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 20px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <button type="submit" name="createPdfButton" id="createPdfButton">Create PDF</button>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>

                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</form>