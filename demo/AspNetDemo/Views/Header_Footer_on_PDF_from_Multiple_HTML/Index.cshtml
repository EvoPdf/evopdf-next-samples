@model EvoPdf_Next_AspNetDemo.Models.HTML_to_PDF.Header_Footer_on_PDF_from_Multiple_HTML_ViewModel
@{
    ViewBag.Title = "Add HTML in Header and Footer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    function toggleHeaderSource(convertUrl) {
        var urlPanel = document.getElementById("headerUrlPanel");
        var htmlStringPanel = document.getElementById("headerHtmlPanel");

        if (convertUrl && urlPanel.style.display == "none") {
            urlPanel.style.display = "block";
            htmlStringPanel.style.display = "none";
        }
        else if (!convertUrl && htmlStringPanel.style.display == "none") {
            urlPanel.style.display = "none";
            htmlStringPanel.style.display = "block";
        }
    }

    function toggleFooterSource(convertUrl) {
        var urlPanel = document.getElementById("footerUrlPanel");
        var htmlStringPanel = document.getElementById("footerHtmlPanel");

        if (convertUrl && urlPanel.style.display == "none") {
            urlPanel.style.display = "block";
            htmlStringPanel.style.display = "none";
        }
        else if (!convertUrl && htmlStringPanel.style.display == "none") {
            urlPanel.style.display = "none";
            htmlStringPanel.style.display = "block";
        }
    }

    TreeView_SelectNode("demoTreeView_Header_Footer_on_PDF_from_Multiple_HTML");
</script>

