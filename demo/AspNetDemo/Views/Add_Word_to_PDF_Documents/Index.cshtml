@model EvoPdf_Next_AspNetDemo.Models.Word_to_PDF.Add_Word_to_PDF_Documents_ViewModel
@{
    ViewBag.Title = "Add Word Documents to PDF Documents";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    TreeView_SelectNode("demoTreeView_Add_Word_to_PDF_Documents");
</script>

<form asp-action="CreatePdf" asp-controller="Add_Word_to_PDF_Documents" method="post" enctype="multipart/form-data">
    <table style="width: 100%; height: 100%">
        <tbody>
            <tr>
                <td style="border: solid 1px Black; padding-top: 10px; padding-left: 10px; padding-right: 10px; padding-bottom: 0px">
                    <table style="width: 100%; height: 100%">
                        <tbody>
                            <tr>
                                <td style="font-size: 16px; font-weight: bold; height: 20px; padding-bottom: 8px; padding-top: 5px">
                                    Add Word Documents to PDF Documents
                                </td>
                            </tr>
                            <tr>
                                <td style="width: 100%;">

                                    <table style="width: 535px; height: 967px">
                                        <tbody>
                                            <tr>
                                                <td style="vertical-align: top">
                                                    <table>
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    A Word document can be rendered inside a PDF document created with the PDF creator, as an element placed at a position of
                                                                    the current page. The content continues on new pages when it does not fit in the page, keeps its structure, links and images,
                                                                    and its headings can join the outline of the PDF document. The elements added after it go to its last page, below it.<br /><br />
                                                                    The generated document has a title and a paragraph created with text elements, the content of the Word document and a
                                                                    closing text after it.
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="padding-bottom: 5px; font-weight: bold">
                                                                                    Enter Word .DOCX File URL
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td>
                                                                                    <input asp-for="WordFileUrl" type="text" id="wordFileUrlTextBox" style="width:500px;">
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="padding-bottom: 5px; font-weight: bold">
                                                                                    Upload Word .DOCX File
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td>
                                                                                    <span style="display:inline-block; border:1px solid #C0C0C0; padding:1px 1px; vertical-align:middle;">
                                                                                        <input asp-for="WordFile" type="file" id="WordFileInput" accept=".docx" style="width:250px; vertical-align:middle;">
                                                                                    </span>
                                                                                    <button type="button" onclick="document.getElementById('WordFileInput').value='';" style="margin-left:5px; vertical-align:middle;">
                                                                                        Clear File
                                                                                    </button>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="font-weight: bold" colspan="2">
                                                                                    Element Options
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="height: 10px" colspan="2"></td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    X:
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    <input asp-for="ElementX" type="text" id="elementXTextBox" style="width:40px;">
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    pt
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    Width:
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    <input asp-for="ElementWidth" type="text" id="elementWidthTextBox" style="width:40px;">
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    pt (0 for the page width)
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    Zoom:
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    <input asp-for="ElementZoom" type="text" id="elementZoomTextBox" style="width:40px;">
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    %
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td style="height: 8px" colspan="9"></td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    <input asp-for="GenerateDocumentOutline" id="generateDocumentOutlineCheckBox" type="checkbox"><label for="generateDocumentOutlineCheckBox">Add the Headings to the Outline</label>
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    <input asp-for="FitWideContentToPage" id="fitWideContentToPageCheckBox" type="checkbox"><label for="fitWideContentToPageCheckBox">Fit Wide Content to Page</label>
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    <input asp-for="UseEmbeddedFonts" id="useEmbeddedFontsCheckBox" type="checkbox"><label for="useEmbeddedFontsCheckBox">Use the Fonts Stored in the Document</label>
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="font-weight: bold" colspan="2">
                                                                                    PDF Compliance
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="height: 10px" colspan="2"></td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    Standard:
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    <select asp-for="PdfStandard" id="pdfStandardDropDownList">
                                                                                                        <option value="None">None</option>

                                                                                                        <optgroup label="PDF/UA">
                                                                                                            <option value="PdfUa1">PDF/UA-1</option>
                                                                                                            <option value="PdfUa2">PDF/UA-2</option>
                                                                                                        </optgroup>

                                                                                                        <optgroup label="PDF/A-2">
                                                                                                            <option value="PdfA2b">PDF/A-2b</option>
                                                                                                            <option value="PdfA2a">PDF/A-2a</option>
                                                                                                            <option value="PdfUa1PdfA2b">PDF/UA-1 + PDF/A-2b</option>
                                                                                                            <option value="PdfUa1PdfA2a">PDF/UA-1 + PDF/A-2a</option>
                                                                                                            <option value="PdfUa2PdfA2b">PDF/UA-2 + PDF/A-2b</option>
                                                                                                            <option value="PdfUa2PdfA2a">PDF/UA-2 + PDF/A-2a</option>
                                                                                                        </optgroup>

                                                                                                        <optgroup label="PDF/A-3">
                                                                                                            <option value="PdfA3b">PDF/A-3b</option>
                                                                                                            <option value="PdfA3u">PDF/A-3u</option>
                                                                                                            <option value="PdfA3a">PDF/A-3a</option>
                                                                                                            <option value="PdfUa1PdfA3a">PDF/UA-1 + PDF/A-3a</option>
                                                                                                        </optgroup>

                                                                                                        <optgroup label="PDF/A-4">
                                                                                                            <option value="PdfA4">PDF/A-4</option>
                                                                                                            <option value="PdfUa2PdfA4">PDF/UA-2 + PDF/A-4</option>
                                                                                                        </optgroup>

                                                                                                    </select>
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <button type="submit" name="createPdfButton" id="createPdfButton">Create PDF</button>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 5px"></td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>

                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</form>
