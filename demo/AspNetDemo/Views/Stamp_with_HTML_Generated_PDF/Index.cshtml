@model EvoPdf_Next_AspNetDemo.Models.HTML_to_PDF.Stamp_with_HTML_Generated_PDF_ViewModel
@{
    ViewBag.Title = "Add HTML Stamp to Generated PDF";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    function toggleStampSource(convertUrl) {
        var urlPanel = document.getElementById("stampUrlPanel");
        var htmlStringPanel = document.getElementById("stampHtmlPanel");

        if (convertUrl && urlPanel.style.display == "none") {
            urlPanel.style.display = "block";
            htmlStringPanel.style.display = "none";
        }
        else if (!convertUrl && htmlStringPanel.style.display == "none") {
            urlPanel.style.display = "none";
            htmlStringPanel.style.display = "block";
        }
    }

    TreeView_SelectNode("demoTreeView_Stamp_with_HTML_Generated_PDF");
</script>

