                                                                                                <td style="width: 5px"></td>
                                                                                                <td>
                                                                                                    <input asp-for="ElementHeight" type="text" id="elementHeightTextBox" style="width:40px;"> pt
                                                                                                </td>
                                                                                            </tr>
                                                                                            <tr>
                                                                                                <td colspan="7" style="font-size: 11px; color: #606060; padding-bottom: 4px">
                                                                                                    0 for the width draws the image at the size of the content on screen, scaled down to the page width when it is wider; 0 for the height gives no limit
                                                                                                </td>
                                                                                            </tr>
