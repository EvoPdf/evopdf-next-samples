@model EvoPdf_Next_AspNetDemo.Models.PDF_Editor.Add_HTML_as_Image_to_Existing_PDF_ViewModel
@{
    ViewBag.Title = "Add HTML as Image to Existing PDF";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    function toggleHtmlSource(convertUrl) {
        var urlPanel = document.getElementById("urlPanel");
        var htmlStringPanel = document.getElementById("htmlStringPanel");

        if (convertUrl && urlPanel.style.display == "none") {
            urlPanel.style.display = "block";
            htmlStringPanel.style.display = "none";
        }
        else if (!convertUrl && htmlStringPanel.style.display == "none") {
            urlPanel.style.display = "none";
            htmlStringPanel.style.display = "block";
        }
    }

    TreeView_SelectNode("demoTreeView_Add_HTML_as_Image_to_Existing_PDF");
</script>

<form asp-action="EditPdf" asp-controller="Add_HTML_as_Image_to_Existing_PDF" method="post" enctype="multipart/form-data">
    <table style="width: 100%; height: 100%">
        <tbody>
            <tr>
                <td style="border: solid 1px Black; padding-top: 10px; padding-left: 10px; padding-right: 10px; padding-bottom: 0px">
                    <table style="width: 100%; height: 100%">
                        <tbody>
                            <tr>
                                <td style="font-size: 16px; font-weight: bold; height: 20px; padding-bottom: 8px; padding-top: 5px">
                                    Add HTML as Image to Existing PDF
                                </td>
                            </tr>
                            <tr>
                                <td style="width: 100%;">

                                    <table style="width: 535px; height: 967px">
                                        <tbody>
                                            <tr>
                                                <td style="vertical-align: top">
                                                    <table>
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    Edit an existing PDF document by rendering HTML content as an image on its first page, below a title and the header of the page. The image
                                                                    continues on the next pages when it is taller than the page, on pages inserted after the current one or on the
                                                                    following pages of the document. PdfEditor keeps the standard of the source PDF.
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 15px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="padding-bottom: 5px; font-weight: bold">
                                                                                    Enter PDF File URL
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td>
                                                                                    <input asp-for="PdfFileUrl" type="text" id="pdfFileUrlTextBox" style="width:500px;">
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 15px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tr>
                                                                            <td style="padding-bottom: 5px; font-weight: bold">
                                                                                Upload PDF File
                                                                            </td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td>
                                                                                <span style="display:inline-block; border:1px solid #C0C0C0; padding:1px 1px; vertical-align:middle;">
                                                                                    <input asp-for="PdfFile" type="file" id="PdfFileInput"
                                                                                           accept=".pdf"
                                                                                           style="width:250px; vertical-align:middle;">
                                                                                </span>
