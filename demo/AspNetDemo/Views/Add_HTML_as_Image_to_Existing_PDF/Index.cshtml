                                                                                            </tr>
                                                                                            <tr>
                                                                                                <td colspan="7">
                                                                                                    <input asp-for="InsertContinuationPages" id="insertContinuationPagesCheckBox" type="checkbox"><label for="insertContinuationPagesCheckBox">Insert the Continuation Pages (keep the pages that follow)</label>
