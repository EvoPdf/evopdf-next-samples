    <script>
        // Demo navigation tree. The demo pages call TreeView_ToggleNode(groupId)
        // and TreeView_SelectNode(pageId); the current page is also detected from the URL.
        function TreeView_ToggleNode(groupId) {
            var group = document.getElementById(groupId);
            if (!group) return;
            var open = group.classList.toggle('open');
            var btn = group.querySelector('.tree-toggle');
            if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        function TreeView_SelectNode(pageId) {
            var link = document.getElementById(pageId);
            if (!link) return;
            link.classList.add('current');
            var group = link.closest('.tree-group');
            if (group && !group.classList.contains('open')) TreeView_ToggleNode(group.id);
        }
        document.addEventListener('DOMContentLoaded', function () {
            var page = location.pathname.split('/').pop().toLowerCase();
            if (!page) return;
            var links = document.querySelectorAll('#demoTreeView .tree-items a');
            for (var i = 0; i < links.length; i++) {
                if (links[i].getAttribute('href').toLowerCase() === page) { TreeView_SelectNode(links[i].id); break; }
            }
        });
    </script>
