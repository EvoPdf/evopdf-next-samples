@model EvoPdf_Next_AspNetDemo.Models.PDF_Creator.Create_PDF_Forms_from_Code_ViewModel
@{
    ViewBag.Title = "Create PDF Forms from Code";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    TreeView_SelectNode("demoTreeView_Create_PDF_Forms_from_Code");
</script>

<form asp-action="CreatePdf" asp-controller="Create_PDF_Forms_from_Code" method="post">
    <table style="width: 100%; height: 100%">
        <tbody>
            <tr>
                <td style="border: solid 1px Black; padding-top: 10px; padding-left: 10px; padding-right: 10px; padding-bottom: 0px">
                    <table style="width: 100%; height: 100%">
                        <tbody>
                            <tr>
                                <td style="font-size: 16px; font-weight: bold; height: 20px; padding-bottom: 8px; padding-top: 5px">
                                    Create PDF Forms from Code
                                </td>
                            </tr>
                            <tr>
                                <td style="width: 100%;">

                                    <table style="width: 535px; height: 967px">
                                        <tbody>
                                            <tr>
                                                <td style="vertical-align: top">
                                                    <table>
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    Use this demo to create a PDF form from code with the PDF creator. The generated registration form has text fields,
                                                                    a comb field, a combo box, radio buttons, a multiple selection list box, check boxes, a multiline text field, a read-only
                                                                    calculated field and push buttons. The fields can have keystroke, format, validate and calculate scripts and the buttons
                                                                    can submit the form, reset it, print the document, hide fields, go to a page or open a web address. A document level
                                                                    script defines a function used by the validate script of the email field. The same fields can be added to an existing document with the PDF editor.<br /><br />
                                                                    The actions and the scripts are not added to PDF/A documents, which do not allow them.
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="font-weight: bold" colspan="2">
                                                                                    Field Options
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="height: 10px" colspan="2"></td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    <input asp-for="AddFieldActions" id="addFieldActionsCheckBox" type="checkbox"><label for="addFieldActionsCheckBox">Add the Scripts and the Actions of the Fields</label>
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    <input asp-for="AddDocumentScript" id="addDocumentScriptCheckBox" type="checkbox"><label for="addDocumentScriptCheckBox">Add the Document Level Script</label>
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td style="height: 8px" colspan="9"></td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    Check Box Style:
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    <select asp-for="CheckBoxStyle" id="checkBoxStyleDropDownList"><option value="Check">Check</option><option value="Circle">Circle</option><option value="Cross">Cross</option><option value="Diamond">Diamond</option><option value="Square">Square</option><option value="Star">Star</option></select>
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    Border Style:
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    <select asp-for="BorderStyle" id="borderStyleDropDownList"><option value="Solid">Solid</option><option value="Dashed">Dashed</option><option value="Beveled">Beveled</option><option value="Inset">Inset</option><option value="Underline">Underline</option></select>
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td style="height: 8px" colspan="9"></td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    <input asp-for="RequiredFields" id="requiredFieldsCheckBox" type="checkbox"><label for="requiredFieldsCheckBox">Mark the Name, Email and Terms Fields as Required</label>
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    <input asp-for="FlattenFields" id="flattenFieldsCheckBox" type="checkbox"><label for="flattenFieldsCheckBox">Flatten the Fields to Static Content</label>
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="font-weight: bold" colspan="2">
                                                                                    PDF Compliance
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="height: 10px" colspan="2"></td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    Standard:
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    <select asp-for="PdfStandard" id="pdfStandardDropDownList">
                                                                                                        <option value="None">None</option>

                                                                                                        <optgroup label="PDF/UA">
                                                                                                            <option value="PdfUa1">PDF/UA-1</option>
                                                                                                            <option value="PdfUa2">PDF/UA-2</option>
                                                                                                        </optgroup>

                                                                                                        <optgroup label="PDF/A-2">
                                                                                                            <option value="PdfA2b">PDF/A-2b</option>
                                                                                                            <option value="PdfA2a">PDF/A-2a</option>
                                                                                                            <option value="PdfUa1PdfA2b">PDF/UA-1 + PDF/A-2b</option>
                                                                                                            <option value="PdfUa1PdfA2a">PDF/UA-1 + PDF/A-2a</option>
                                                                                                            <option value="PdfUa2PdfA2b">PDF/UA-2 + PDF/A-2b</option>
                                                                                                            <option value="PdfUa2PdfA2a">PDF/UA-2 + PDF/A-2a</option>
                                                                                                        </optgroup>

                                                                                                        <optgroup label="PDF/A-3">
                                                                                                            <option value="PdfA3b">PDF/A-3b</option>
                                                                                                            <option value="PdfA3u">PDF/A-3u</option>
                                                                                                            <option value="PdfA3a">PDF/A-3a</option>
                                                                                                            <option value="PdfUa1PdfA3a">PDF/UA-1 + PDF/A-3a</option>
                                                                                                        </optgroup>

                                                                                                        <optgroup label="PDF/A-4">
                                                                                                            <option value="PdfA4">PDF/A-4</option>
                                                                                                            <option value="PdfUa2PdfA4">PDF/UA-2 + PDF/A-4</option>
                                                                                                        </optgroup>

                                                                                                    </select>
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <button type="submit" name="createPdfButton" id="createPdfButton">Create PDF</button>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 5px"></td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>

                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</form>
