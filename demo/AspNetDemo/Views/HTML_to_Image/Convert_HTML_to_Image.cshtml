@model EvoPdf_Next_AspNetDemo.Models.HTML_to_Image.Convert_HTML_to_Image_ViewModel
@{
    ViewBag.Title = "Convert HTML to Raster Image";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    function toggleHtmlSource(convertUrl) {
        var urlPanel = document.getElementById("urlPanel");
        var htmlStringPanel = document.getElementById("htmlStringPanel");

        if (convertUrl && urlPanel.style.display == "none") {
            urlPanel.style.display = "block";
            htmlStringPanel.style.display = "none";
        }
        else if (!convertUrl && htmlStringPanel.style.display == "none") {
            urlPanel.style.display = "none";
            htmlStringPanel.style.display = "block";
        }
    }

    function togglePngPanel(selectedOption) {
        var enablePanel = selectedOption == "Png";
        var pngPanel = document.getElementById("pngPanel");

        if (enablePanel) {
            pngPanel.style.display = "block";
        }
        else {
            pngPanel.style.display = "none";
        }
    }

    TreeView_ToggleNode("demoTreeView_HTML_To_PDF_Converter");
    TreeView_ToggleNode("demoTreeView_HTML_to_Image");
    TreeView_SelectNode("demoTreeView_Convert_HTML_to_Image");
</script>

