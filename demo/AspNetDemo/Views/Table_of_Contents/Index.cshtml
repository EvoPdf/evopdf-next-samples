@model EvoPdf_Next_AspNetDemo.Models.HTML_to_PDF.Table_of_Contents_ViewModel
@{
    ViewBag.Title = "Auto Create Table of Contents";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    function toggleHtmlSource(convertUrl) {
        var urlPanel = document.getElementById("urlPanel");
        var htmlStringPanel = document.getElementById("htmlStringPanel");

        if (convertUrl && urlPanel.style.display == "none") {
            urlPanel.style.display = "block";
            htmlStringPanel.style.display = "none";
        }
        else if (!convertUrl && htmlStringPanel.style.display == "none") {
            urlPanel.style.display = "none";
            htmlStringPanel.style.display = "block";
        }
    }

    function toggleUseBrowserVisibility() {
        var inlineTocCheckBox = document.getElementById("inlineTocCheckBox");
        var useBrowserCheckBox = document.getElementById("useBrowserModeCheckBox");
        var useBrowserLabel = document.getElementById("useBrowserModeLabel");

        if (inlineTocCheckBox.checked) {
            useBrowserCheckBox.style.display = "none";
            useBrowserLabel.style.display = "none";
        } else {
            useBrowserCheckBox.style.display = "inline-block";
            useBrowserLabel.style.display = "inline-block";
        }
    }

    TreeView_SelectNode("demoTreeView_Table_of_Contents");
</script>

