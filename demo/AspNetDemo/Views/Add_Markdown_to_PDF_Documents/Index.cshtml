@model EvoPdf_Next_AspNetDemo.Models.Markdown_to_PDF.Add_Markdown_to_PDF_Documents_ViewModel
@{
    ViewBag.Title = "Add Markdown Content to PDF Documents";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    function toggleSource(fromUrl) {
        document.getElementById("urlPanel").style.display = fromUrl ? "block" : "none";
        document.getElementById("stringPanel").style.display = fromUrl ? "none" : "block";
    }

    TreeView_SelectNode("demoTreeView_Add_Markdown_to_PDF_Documents");
</script>

