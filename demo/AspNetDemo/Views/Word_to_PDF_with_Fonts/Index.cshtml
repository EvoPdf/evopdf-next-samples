@model EvoPdf_Next_AspNetDemo.Models.Word_to_PDF.Word_to_PDF_with_Fonts_ViewModel
@{
    ViewBag.Title = "Convert Word to PDF with Document and Custom Fonts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    TreeView_SelectNode("demoTreeView_Word_to_PDF_with_Fonts");
</script>

<form asp-action="ConvertWordToPdf" asp-controller="Word_to_PDF_with_Fonts" method="post" enctype="multipart/form-data">
    <table style="width: 100%; height: 100%">
        <tbody>
            <tr>
                <td style="border: solid 1px Black; padding-top: 10px; padding-left: 10px; padding-right: 10px; padding-bottom: 0px">
                    <table style="width: 100%; height: 100%">
                        <tbody>
                            <tr>
                                <td style="font-size: 16px; font-weight: bold; height: 20px; padding-bottom: 8px; padding-top: 5px">
                                    Convert Word to PDF with Document and Custom Fonts
                                </td>
                            </tr>
                            <tr>
                                <td style="width: 100%;">

                                    <table style="width: 535px; height: 967px">
                                        <tbody>
                                            <tr>
                                                <td style="vertical-align: top">
                                                    <table>
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    The Word to PDF converter can use the fonts stored in the Word document, the fonts given to it as files and fallback font files
                                                                    for the characters that no font of the document covers. The sample document has a paragraph in a font stored in the document,
                                                                    a paragraph in DejaVu Serif, a font given to the converter as a file and a paragraph in Arabic rendered with the Noto Sans
                                                                    Arabic fallback font file.<br /><br />
                                                                    Convert the document with the options below on and off and compare the generated PDF documents.
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="padding-bottom: 5px; font-weight: bold">
                                                                                    Enter Word .DOCX File URL
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td>
                                                                                    <input asp-for="WordFileUrl" type="text" id="wordFileUrlTextBox" style="width:500px;">
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="padding-bottom: 5px; font-weight: bold">
                                                                                    Upload Word .DOCX File
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td>
                                                                                    <span style="display:inline-block; border:1px solid #C0C0C0; padding:1px 1px; vertical-align:middle;">
                                                                                        <input asp-for="WordFile" type="file" id="WordFileInput" accept=".docx" style="width:250px; vertical-align:middle;">
                                                                                    </span>
                                                                                    <button type="button" onclick="document.getElementById('WordFileInput').value='';" style="margin-left:5px; vertical-align:middle;">
                                                                                        Clear File
                                                                                    </button>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="font-weight: bold" colspan="2">
                                                                                    Font Options
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="height: 10px" colspan="2"></td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    <input asp-for="UseEmbeddedFonts" id="useEmbeddedFontsCheckBox" type="checkbox"><label for="useEmbeddedFontsCheckBox">Use the Fonts Stored in the Word Document</label>
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td style="height: 8px" colspan="9"></td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    <input asp-for="UseFontFile" id="useFontFileCheckBox" type="checkbox"><label for="useFontFileCheckBox">Give the DejaVuSerif.ttf Font File to the Converter</label>
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td style="height: 8px" colspan="9"></td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    <input asp-for="UseFallbackFontFile" id="useFallbackFontFileCheckBox" type="checkbox"><label for="useFallbackFontFileCheckBox">Give the NotoSansArabic-Regular.ttf Fallback Font File to the Converter</label>
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <button type="submit" name="convertToPdfButton" id="convertToPdfButton">Convert Word to PDF</button>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 5px"></td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>

                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</form>
