                                                                                                <td>
                                                                                                    <input asp-for="RetrieveElementPositions" id="retrieveElementPositionsCheckBox" type="checkbox"><label for="retrieveElementPositionsCheckBox">Report the Positions of the Elements Matching:</label>
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    <input asp-for="HtmlElementsSelector" type="text" id="htmlElementsSelectorTextBox" style="width:150px;">
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td style="height: 8px" colspan="9"></td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    <input asp-for="AddSecondElement" id="addSecondElementCheckBox" type="checkbox"><label for="addSecondElementCheckBox">Add a Second HTML Element after the First One</label>
                                                                                                </td>
                                                                                                <td style="width: 10px"></td>
                                                                                                <td>
                                                                                                    <input asp-for="AddPageNumbers" id="addPageNumbersCheckBox" type="checkbox"><label for="addPageNumbersCheckBox">Add the Page Numbers in All the Pages</label>
                                                                                                </td>
                                                                                            </tr>
                                                                                            <tr>
                                                                                                <td colspan="3">
                                                                                                    <input asp-for="FollowingElementsOnNewPage" id="followingElementsOnNewPageCheckBox" type="checkbox"><label for="followingElementsOnNewPageCheckBox">Add the Following Elements on a New Page after the HTML Content (instead of at the End of the Content)</label>
                                                                                                </td>
