@model EvoPdf_Next_AspNetDemo.Models.RTF_to_PDF.RTF_to_PDF_with_Document_Headers_ViewModel
@{
    ViewBag.Title = "Convert RTF to PDF with Document Headers and Footers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    function toggleHtmlHeader() {
        var panel = document.getElementById("htmlHeaderPanel");
        panel.style.display = document.getElementById("addHtmlHeaderCheckBox").checked ? "block" : "none";
    }

    function toggleHtmlFooter() {
        var panel = document.getElementById("htmlFooterPanel");
        panel.style.display = document.getElementById("addHtmlFooterCheckBox").checked ? "block" : "none";
    }

    TreeView_SelectNode("demoTreeView_RTF_to_PDF_with_Document_Headers");
</script>

<form asp-action="ConvertRtfToPdf" asp-controller="RTF_to_PDF_with_Document_Headers" method="post" enctype="multipart/form-data">
    <table style="width: 100%; height: 100%">
        <tbody>
            <tr>
                <td style="border: solid 1px Black; padding-top: 10px; padding-left: 10px; padding-right: 10px; padding-bottom: 0px">
                    <table style="width: 100%; height: 100%">
                        <tbody>
                            <tr>
                                <td style="font-size: 16px; font-weight: bold; height: 20px; padding-bottom: 8px; padding-top: 5px">
                                    Convert RTF to PDF with Document Headers and Footers
                                </td>
                            </tr>
                            <tr>
                                <td style="width: 100%;">

                                    <table style="width: 535px; height: 967px">
                                        <tbody>
                                            <tr>
                                                <td style="vertical-align: top">
                                                    <table>
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    The RTF to PDF converter renders the header and the footer of the RTF document on the PDF pages, with the page number and
                                                                    page count fields they contain and with a different first page when the document has one. The sample document has a title page
                                                                    without header and footer, followed by pages with a running header and a footer with the page number and the page count.<br /><br />
                                                                    A HTML header or footer set in the converter takes the place of the document one.
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="padding-bottom: 5px; font-weight: bold">
                                                                                    Enter RTF File URL
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td>
                                                                                    <input asp-for="RtfFileUrl" type="text" id="rtfFileUrlTextBox" style="width:500px;">
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="padding-bottom: 5px; font-weight: bold">
                                                                                    Upload RTF File
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td>
                                                                                    <span style="display:inline-block; border:1px solid #C0C0C0; padding:1px 1px; vertical-align:middle;">
                                                                                        <input asp-for="RtfFile" type="file" id="RtfFileInput" accept=".rtf" style="width:250px; vertical-align:middle;">
                                                                                    </span>
                                                                                    <button type="button" onclick="document.getElementById('RtfFileInput').value='';" style="margin-left:5px; vertical-align:middle;">
                                                                                        Clear File
                                                                                    </button>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="font-weight: bold" colspan="2">
                                                                                    Document Header and Footer
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="height: 10px" colspan="2"></td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    <input asp-for="UseHeaderFooterFromRtf" id="useHeaderFooterFromRtfCheckBox" type="checkbox"><label for="useHeaderFooterFromRtfCheckBox">Render the Header and Footer of the Document on the PDF Pages</label>
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="font-weight: bold" colspan="2">
                                                                                    HTML Header
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="height: 10px" colspan="2"></td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    <input asp-for="AddHtmlHeader" id="addHtmlHeaderCheckBox" type="checkbox" onclick="javascript: toggleHtmlHeader()"><label for="addHtmlHeaderCheckBox">Add a HTML Header in Place of the Document Header</label>
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    <div id="htmlHeaderPanel" style="display:none"><table><tbody><tr><td>HTML:</td></tr><tr><td><textarea asp-for="HeaderHtmlTextBox" id="headerHtmlTextBox" style="width:480px; height:80px"></textarea></td></tr><tr><td>Base URL: <input asp-for="HeaderHtmlBaseUrlTextBox" type="text" id="headerHtmlBaseUrlTextBoxTextBox" style="width:400px;"></td></tr></tbody></table></div>
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="font-weight: bold" colspan="2">
                                                                                    HTML Footer
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="height: 10px" colspan="2"></td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    <input asp-for="AddHtmlFooter" id="addHtmlFooterCheckBox" type="checkbox" onclick="javascript: toggleHtmlFooter()"><label for="addHtmlFooterCheckBox">Add a HTML Footer in Place of the Document Footer</label>
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    <div id="htmlFooterPanel" style="display:none"><table><tbody><tr><td>HTML:</td></tr><tr><td><textarea asp-for="FooterHtmlTextBox" id="footerHtmlTextBox" style="width:480px; height:80px"></textarea></td></tr><tr><td>Base URL: <input asp-for="FooterHtmlBaseUrlTextBox" type="text" id="footerHtmlBaseUrlTextBoxTextBox" style="width:400px;"></td></tr></tbody></table></div>
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 12px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <button type="submit" name="convertToPdfButton" id="convertToPdfButton">Convert RTF to PDF</button>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 5px"></td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>

                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</form>
