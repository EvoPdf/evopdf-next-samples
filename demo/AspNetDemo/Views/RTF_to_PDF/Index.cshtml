@model EvoPdf_Next_AspNetDemo.Models.RTF_to_PDF.RTF_to_PDF_ViewModel
@{
    ViewBag.Title = "Getting Started with RTF to PDF Converter";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    function togglePdfPageSettingsMode(enablePanel) {
        var settingsPanel = document.getElementById("pdfPageSettingsModePanel");

        if (enablePanel) {
            settingsPanel.style.display = "block";
        }
        else {
            settingsPanel.style.display = "none";
        }
    }

    function toggleHeaderOptions() {
        var settingsPanel = document.getElementById("headerOptionsPanel");

        if (settingsPanel.style.display == "none")
            settingsPanel.style.display = "block";
        else
            settingsPanel.style.display = "none";
    }

    function toggleFooterOptions() {
        var settingsPanel = document.getElementById("footerOptionsPanel");

        if (settingsPanel.style.display == "none")
            settingsPanel.style.display = "block";
        else
            settingsPanel.style.display = "none";
    }

    function toggleHeaderSource(convertUrl) {
        var urlPanel = document.getElementById("headerUrlPanel");
        var htmlStringPanel = document.getElementById("headerHtmlPanel");

        if (convertUrl && urlPanel.style.display == "none") {
            urlPanel.style.display = "block";
            htmlStringPanel.style.display = "none";
        }
        else if (!convertUrl && htmlStringPanel.style.display == "none") {
            urlPanel.style.display = "none";
            htmlStringPanel.style.display = "block";
        }
    }

    function toggleFooterSource(convertUrl) {
        var urlPanel = document.getElementById("footerUrlPanel");
        var htmlStringPanel = document.getElementById("footerHtmlPanel");

        if (convertUrl && urlPanel.style.display == "none") {
            urlPanel.style.display = "block";
            htmlStringPanel.style.display = "none";
        }
        else if (!convertUrl && htmlStringPanel.style.display == "none") {
            urlPanel.style.display = "none";
            htmlStringPanel.style.display = "block";
        }
    }

    TreeView_ToggleNode("demoTreeView_HTML_To_PDF_Converter");
    TreeView_ToggleNode("demoTreeView_RTF_to_PDF");
    TreeView_SelectNode("demoTreeView_RTF_to_PDF_Demo");
</script>

