@{
    ViewBag.Title = "Create Electronic Invoices (ZUGFeRD and Factur-X)";
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewData["HtmlStringToConvert"] = System.IO.File.ReadAllText(ViewData["ContentRootPath"].ToString() + "/DemoAppFiles/Input/HTML_Files/Electronic_Invoice.html");
    String currentPageUrl = ViewData["CurrentPageUrl"].ToString();
    String rootUrl = currentPageUrl.Substring(0, currentPageUrl.Length - "Create_Electronic_Invoice".Length);
    ViewData["BaseUrl"] = rootUrl + "DemoAppFiles/Input/HTML_Files/";
}

<script>
    TreeView_ToggleNode("demoTreeView_Electronic_Invoices");
    TreeView_SelectNode("demoTreeView_Create_Electronic_Invoice");

    // Shows the HTML page that matches the selected sample: the invoice, the credit note or the order
    function loadSamplePage(dropDownList) {
        var page = dropDownList.options[dropDownList.selectedIndex].getAttribute("data-page");
        var baseUrl = document.getElementById("baseUrlTextBox").value;
        fetch(baseUrl + page).then(function (response) { return response.text(); }).then(function (html) {
            document.getElementById("htmlStringTextBox").value = html;
        });
    }
</script>

@using (Html.BeginForm("ConvertHtmlToPdf", "Create_Electronic_Invoice", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <table style="width: 100%; height: 100%">
        <tbody>
            <tr>
                <td style="border: solid 1px Black; padding-top: 10px; padding-left: 10px;
                padding-right: 10px; padding-bottom: 0px">
                    <table style="width: 100%; height: 100%">
                        <tbody>
                            <tr>
                                <td style="font-size: 16px; font-weight: bold; height: 20px; padding-bottom: 15px;
                            padding-top: 5px">
                                    Create Electronic Invoices (ZUGFeRD and Factur-X)
                                </td>
                            </tr>
                            <tr>
                                <td style="width: 100%;">

                                    <table style="width: 535px; height: 927px">
                                        <tbody>
                                            <tr>
                                                <td style="vertical-align: top">
                                                    <table>
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    A hybrid electronic invoice carries the invoice twice in one PDF: the page a person
                                                                    reads and the XML an accounting system reads. ZUGFeRD (Germany) and Factur-X (France)
                                                                    are the same standard under two names, with the MINIMUM, BASIC WL, BASIC, EN 16931,
                                                                    EXTENDED and XRECHNUNG profiles; credit notes are carried the same way and purchase
                                                                    orders use Order-X. The classic converter runs over the EvoPdf.Next converter and
                                                                    exposes it, so the electronic invoice support of EvoPdf.Next is available from the
                                                                    classic API: the profile is read from the XML and the PDF/A-3 document receives the
                                                                    embedded file and the metadata the standard prescribes.
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 20px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="font-weight: bold">
                                                                                    Invoice HTML to Convert
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td>
                                                                                    <textarea name="htmlStringTextBox" rows="2" cols="20" id="htmlStringTextBox" style="height:200px;width:500px;">@(ViewData["HtmlStringToConvert"].ToString())</textarea>
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="height: 10px"></td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="font-weight: bold">
                                                                                    Base URL
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td>
                                                                                    <input name="baseUrlTextBox" type="text" value="@(ViewData["BaseUrl"].ToString())" id="baseUrlTextBox" style="width:500px;">
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 20px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="font-weight: bold" colspan="2">
                                                                                    Invoice XML
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="height: 10px" colspan="2"></td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    Sample invoice:
                                                                                                </td>
                                                                                                <td style="width: 5px"></td>
                                                                                                <td>
                                                                                                    <select name="sampleInvoiceDropDownList" id="sampleInvoiceDropDownList" onchange="loadSamplePage(this)">
                                                                                                        <option selected="selected" value="Invoice_MINIMUM.xml" data-page="Electronic_Invoice.html">MINIMUM (header data only)</option>
                                                                                                        <option value="Invoice_BASIC_WL.xml" data-page="Electronic_Invoice.html">BASIC WL (header data, no invoice lines)</option>
                                                                                                        <option value="Invoice_BASIC.xml" data-page="Electronic_Invoice.html">BASIC (invoice lines, core elements)</option>
                                                                                                        <option value="Invoice_EN_16931.xml" data-page="Electronic_Invoice.html">EN 16931 (the full European standard)</option>
                                                                                                        <option value="Invoice_EXTENDED.xml" data-page="Electronic_Invoice.html">EXTENDED (EN 16931 plus extensions)</option>
                                                                                                        <option value="Invoice_XRECHNUNG.xml" data-page="Electronic_Invoice.html">XRECHNUNG (German public sector)</option>
                                                                                                        <option value="Invoice_CREDIT_NOTE.xml" data-page="Electronic_Credit_Note.html">EN 16931 credit note</option>
                                                                                                        <option value="Order_COMFORT.xml" data-page="Electronic_Order.html">Order-X COMFORT (purchase order)</option>
                                                                                                    </select>
                                                                                                </td>
                                                                                            </tr>
                                                                                            <tr>
                                                                                                <td style="height: 8px" colspan="3"></td>
                                                                                            </tr>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    Or upload your XML:
                                                                                                </td>
                                                                                                <td style="width: 5px"></td>
                                                                                                <td>
                                                                                                    <input name="invoiceXmlFileInput" type="file" id="invoiceXmlFileInput" accept=".xml" style="width:250px;">
                                                                                                    <button type="button" onclick="document.getElementById('invoiceXmlFileInput').value='';" style="margin-left:5px;">Clear File</button>
                                                                                                </td>
                                                                                            </tr>
                                                                                            <tr>
                                                                                                <td style="height: 8px" colspan="3"></td>
                                                                                            </tr>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    Relationship to the page:
                                                                                                </td>
                                                                                                <td style="width: 5px"></td>
                                                                                                <td>
                                                                                                    <select name="relationshipDropDownList" id="relationshipDropDownList">
                                                                                                        <option selected="selected" value="Alternative">Alternative (the XML and the page carry the same invoice)</option>
                                                                                                        <option value="Data">Data (the page shows more than the XML)</option>
                                                                                                        <option value="Source">Source (the page was generated from the XML)</option>
                                                                                                    </select>
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 20px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td style="font-weight: bold" colspan="2">
                                                                                    PDF Standard (an option of the EvoPdf.Next converter)
                                                                                </td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="height: 10px" colspan="2"></td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td style="width: 20px"></td>
                                                                                <td>
                                                                                    <table>
                                                                                        <tbody>
                                                                                            <tr>
                                                                                                <td>
                                                                                                    Standard:
                                                                                                </td>
                                                                                                <td style="width: 5px"></td>
                                                                                                <td>
                                                                                                    <select name="pdfStandardDropDownList" id="pdfStandardDropDownList">
                                                                                                        <option selected="selected" value="PdfA3b">PDF/A-3b</option>
                                                                                                        <option value="PdfA3u">PDF/A-3u</option>
                                                                                                        <option value="PdfA3a">PDF/A-3a</option>
                                                                                                        <option value="PdfUa1PdfA3a">PDF/UA-1 + PDF/A-3a (accessible invoice)</option>
                                                                                                    </select>
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="height: 20px"></td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <input type="submit" name="convertToPdfButton" value="Create Electronic Invoice" id="convertToPdfButton">
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>

                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
}
